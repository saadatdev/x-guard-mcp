  "description": "MCP server for the X (Twitter) API with cost guardrails, approve-before-post safety and a local spend log.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "x-api",
    "twitter-api",
    "typescript"
  ],
  "license": "MIT",
  "author": "Saadat Baig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadatdev/safe-twitter-mcp.git"
  },
  "homepage": "https://github.com/saadatdev/safe-twitter-mcp#readme",
  "bugs": {
    "url": "https://github.com/saadatdev/safe-twitter-mcp/issues"
  },
  "private": true,
  "type": "module",
