# X API credentials (OAuth 1.0a user context).
# console.x.com -> your project -> your app -> "Keys and tokens".

# Consumer keys: "API Key" and "API Key Secret".
X_API_KEY=
X_API_SECRET=

# Access Token and Secret for the account that will post.
# Set App permissions to "Read and write" first, then generate (or regenerate) these.
# A token generated before that change is read-only and posting fails with 403.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
